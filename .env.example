# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# VOICE (speech-to-text, read-aloud, and dictation cleanup)
# =============================================================================
# Set these once and every user gets voice input out of the box — no per-user
# key needed. The backend must be OpenAI-compatible (OpenAI, Groq, or a local
# server exposing /audio/transcriptions and /chat/completions).
#
# Groq example (fast + cheap, great Russian Whisper):
# VOICE_API_BASE_URL=https://api.groq.com/openai/v1
# VOICE_API_KEY=gsk_...
# VOICE_STT_MODEL=whisper-large-v3
#
# Text cleanup: when VOICE_CORRECTION_MODEL is set, dictation is auto-tidied
# (punctuation, capitals, glossary term fixes, filler removal) via a second
# LLM pass. Leave it blank for raw transcription only.
# VOICE_CORRECTION_MODEL=llama-3.3-70b-versatile
# VOICE_LANGUAGE=ru
# VOICE_CORRECTION=true
# Optional read-aloud (TTS):
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy



# --- Third-party model subscriptions (optional) -----------------------------
# Extra models in the picker that run the SAME Claude Code engine against a
# provider's official Anthropic-compatible endpoint, on that provider's own
# flat monthly plan. They keep working when the Claude 5-hour window is spent.
# Skills, hooks, subagents and MCP are client-side features and keep working.
#
# MiniMax M3 — the only one that officially accepts images (screenshots).
#   Plan: platform.minimax.io  ·  endpoint: https://api.minimax.io/anthropic
# MINIMAX_API_KEY=
#
# GLM-5.2 (Z.ai) — the only one that contractually does not train on API data,
# so this is the one for client work.
#   Plan: z.ai/subscribe  ·  endpoint: https://api.z.ai/api/anthropic
# ZAI_API_KEY=


# =============================================================================
# ОТЛИЧИЯ ЭТОГО ИНСТАНСА (все переменные необязательные)
# =============================================================================
# Один и тот же репозиторий собирается и на сервере, и на локальном ноутбуке.
# Всё, чем инстансы отличаются, задаётся здесь. Не задал — работает ровно так,
# как работало раньше. Именно поэтому сюда нельзя переносить хардкод: сервер
# соберётся с этим же кодом и получит чужие настройки.

# Модель, на которой открывается НОВЫЙ чат (движок Claude).
# Пусто/нет строки → как раньше: 'default', то есть модель из настроек CLI.
# Пример для ноутбука с локальными моделями (Ollama):
# VITE_DEFAULT_CLAUDE_MODEL=local-qwen35-9b
# Что важно знать:
#   · это ПЕРЕМЕННАЯ СБОРКИ (префикс VITE_) — меняешь и пересобираешь фронт
#     (`npm run build`), иначе значение не подхватится;
#   · модель, выбранная руками внутри чата, всё равно главнее (она помнится
#     в браузере) — переменная задаёт только старт нового чата;
#   · остальные модели из пикера НИКУДА не деваются, включая облачные;
#   · опечатался в id — интерфейс молча вернётся к модели по умолчанию из
#     каталога, ничего не сломается.

# Спрятать блок проектов в сайдбаре: 1 (или true) — спрятать, пусто/нет — как
# раньше. Нужно, когда инстанс живёт в ОДНОЙ рабочей папке: заголовок папки и
# кнопка «новый проект» исчезают, список чатов остаётся, рабочая папка больше
# не переключается. Сам механизм проектов при этом на месте — на нём держатся
# сессии, прячется только интерфейс. Тоже переменная сборки.
# VITE_HIDE_PROJECTS=1

# Адрес локального LLM-сервера (Ollama), к которому идут модели local-*.
# Пусто/нет строки → http://127.0.0.1:11435.
# На ноутбуке, где Ollama стоит рядом, это её обычный порт:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
